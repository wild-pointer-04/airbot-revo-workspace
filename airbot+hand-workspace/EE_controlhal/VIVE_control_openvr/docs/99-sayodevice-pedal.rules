# SayoDevice CM6K foot pedal / keypad — allow non-root read of input events
# Install (once):
#   sudo cp docs/99-sayodevice-pedal.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
# Or replug the USB cable after installing the rule.
SUBSYSTEM=="input", ATTRS{idVendor}=="8089", ATTRS{idProduct}=="000c", MODE="0666"
KERNEL=="hidraw*", ATTRS{idVendor}=="8089", ATTRS{idProduct}=="000c", MODE="0666"
