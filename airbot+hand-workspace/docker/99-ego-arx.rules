# ARX USB2CAN（MCS 16d0:117e）
SUBSYSTEM=="tty", ATTRS{idVendor}=="16d0", ATTRS{idProduct}=="117e", MODE="0666", GROUP="dialout"
KERNEL=="ttyACM*", MODE="0666", GROUP="dialout"
KERNEL=="ttyUSB*", MODE="0666", GROUP="dialout"

# 本机从臂 USB2CAN -> can1
SUBSYSTEM=="tty", ATTRS{idVendor}=="16d0", ATTRS{idProduct}=="117e", ATTRS{serial}=="001800314C48570920373330", SYMLINK+="arxcan1", MODE="0666", GROUP="dialout"

# HID / Vive Tracker 接收器（Valve 28de, HTC 0bb4）
KERNEL=="hidraw*", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="28de", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="0bb4", MODE="0666", GROUP="plugdev"
SUBSYSTEM=="usb", ATTR{idVendor}=="16d0", MODE="0666", GROUP="plugdev"
