*.svd
*.userprefs

# ---- ROS 2 / colcon ----
build/
install/
log/
devel/
.catkin_workspace
*.colcon_install_layout

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
